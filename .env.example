# ══════════════════════════════════════════════════════════════════════════════
#  MultiAgentic-Becas — .env.example
#
#  El archivo se llama exactamente ".env" (con punto, sin extensión).
#  Ubícalo en la raíz del proyecto: MultiAgentic-becas/.env
#
#  IMPORTANTE: Solo necesitas definir lo que sea diferente al default.
#  Todas las variables tienen valores por defecto en config/settings.py.
# ══════════════════════════════════════════════════════════════════════════════


# ── Backend LLM activo ────────────────────────────────────────────────────────
# Opciones: ollama | vllm | gcp_cpu
# Default: ollama
LLM_PROVIDER=ollama


# ══════════════════════════════════════════════════════════════════════════════
#  OPCIÓN A — Ollama local (CPU, sin GPU) ← RECOMENDADO para GCP VM
# ══════════════════════════════════════════════════════════════════════════════
#  Setup:
#    curl -fsSL https://ollama.com/install.sh | sh
#    ollama pull qwen2.5:1.5b     # para VMs con ~4 GB RAM
#    ollama pull qwen2.5:3b       # para VMs con ~8 GB RAM
#
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TIMEOUT_SECONDS=120


# ══════════════════════════════════════════════════════════════════════════════
#  OPCIÓN B — AMD Instinct MI300X via vLLM (GPU cloud / hackathon)
# ══════════════════════════════════════════════════════════════════════════════
#  Requiere LLM_PROVIDER=vllm
#
REMOTE_LLM_BASE_URL=http://<AMD_DROPLET_IP>:8000/v1
REMOTE_LLM_API_KEY=not-required
REMOTE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
REMOTE_LLM_TIMEOUT_SECONDS=60
REMOTE_LLM_ENDPOINT_TYPE=openai_compatible


# ══════════════════════════════════════════════════════════════════════════════
#  OPCIÓN C — GCP VM remota con Ollama/llama.cpp (CPU)
# ══════════════════════════════════════════════════════════════════════════════
#  Requiere LLM_PROVIDER=gcp_cpu
#
GCP_VM_BASE_URL=http://<GCP_VM_IP>:11434/v1
GCP_VM_API_KEY=
GCP_VM_MODEL=qwen2.5:3b
GCP_VM_TIMEOUT_SECONDS=180


# ══════════════════════════════════════════════════════════════════════════════
#  Pipeline (valores opcionales — los defaults funcionan bien)
# ══════════════════════════════════════════════════════════════════════════════
DATABASE_PATH=data/scholarships.db
LOG_LEVEL=INFO


# ══════════════════════════════════════════════════════════════════════════════
#  Google OAuth 2.0 — Login y cuota de 5 búsquedas por día
# ══════════════════════════════════════════════════════════════════════════════
#  Setup: https://console.cloud.google.com → APIs & Services → Credentials
#  Tipo: Web application
#  Redirect URI autorizado: http://<IP_VM>:8501/
#
#  Generar SESSION_SECRET_KEY:
#    python3 -c "import secrets; print(secrets.token_hex(32))"
#
GOOGLE_CLIENT_ID=<tu-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<tu-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8501/
SESSION_SECRET_KEY=cambia-esto-genera-con-secrets-token-hex-32
MAX_QUERIES_PER_USER=5
