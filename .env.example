# ══════════════════════════════════════════════════════════════════════════════
#  MultiAgentic-Scholarships — .env.example
#  Copy to .env and fill in the values for your chosen backend.
#
#  LLM_PROVIDER controls which inference backend is used:
#
#    ollama    → Local Ollama (dev / no GPU)
#    vllm      → AMD Instinct MI300X via vLLM (hackathon / GPU production)
#    gcp_cpu   → GCP VM with CPU-based Ollama or llama.cpp (CPU production)
#
#  Only configure the section that matches your LLM_PROVIDER.
# ══════════════════════════════════════════════════════════════════════════════


# ── Active backend — change this ONE variable to switch ───────────────────────
# Options: ollama | vllm | gcp_cpu
LLM_PROVIDER=ollama


# ══════════════════════════════════════════════════════════════════════════════
#  BACKEND A — Local Ollama (development, no GPU required)
# ══════════════════════════════════════════════════════════════════════════════
# Setup:
#   Windows/Mac: download from https://ollama.com
#   Linux: curl -fsSL https://ollama.com/install.sh | sh
#   Pull model: ollama pull qwen2.5:7b-instruct
#
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=60


# ══════════════════════════════════════════════════════════════════════════════
#  BACKEND B — AMD Instinct MI300X via vLLM (GPU production / hackathon)
# ══════════════════════════════════════════════════════════════════════════════
# Setup on AMD Developer Cloud droplet:
#   vllm serve Qwen/Qwen2.5-7B-Instruct \
#     --host 0.0.0.0 --port 8000 --max-model-len 8192 --dtype auto
#   ufw allow 8000
#
# Then set LLM_PROVIDER=vllm and fill in the droplet IP:
#
REMOTE_LLM_BASE_URL=http://<AMD_DROPLET_IP>:8000/v1
REMOTE_LLM_API_KEY=not-required
REMOTE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
REMOTE_LLM_TIMEOUT_SECONDS=60
REMOTE_LLM_ENDPOINT_TYPE=openai_compatible


# ══════════════════════════════════════════════════════════════════════════════
#  BACKEND C — GCP VM with CPU-based inference (CPU production / no GPU)
# ══════════════════════════════════════════════════════════════════════════════
# Recommended setup on GCP VM (e2-standard-4 or larger):
#
#   Option 1 — Ollama (easiest):
#     curl -fsSL https://ollama.com/install.sh | sh
#     OLLAMA_HOST=0.0.0.0 ollama serve &
#     ollama pull qwen2.5:3b
#     GCP_VM_BASE_URL=http://<GCP_VM_IP>:11434/v1
#     GCP_VM_MODEL=qwen2.5:3b
#
#   Option 2 — llama.cpp server (most efficient on CPU):
#     ./server -m qwen2.5-3b-q4_k_m.gguf --host 0.0.0.0 --port 8080 -t $(nproc)
#     GCP_VM_BASE_URL=http://<GCP_VM_IP>:8080/v1
#
#   Option 3 — vLLM CPU backend:
#     vllm serve Qwen/Qwen2.5-3B-Instruct --host 0.0.0.0 --port 8000 --device cpu
#     GCP_VM_BASE_URL=http://<GCP_VM_IP>:8000/v1
#
#   Firewall:
#     gcloud compute firewall-rules create allow-llm-inbound \
#       --allow tcp:11434,tcp:8080,tcp:8000 \
#       --source-ranges 0.0.0.0/0 \
#       --target-tags llm-server
#
GCP_VM_BASE_URL=http://<GCP_VM_IP>:11434/v1
GCP_VM_API_KEY=
GCP_VM_MODEL=qwen2.5:3b
GCP_VM_TIMEOUT_SECONDS=180


# ══════════════════════════════════════════════════════════════════════════════
#  Semantic Search (replaces RAG/ChromaDB — no embeddings needed)
# ══════════════════════════════════════════════════════════════════════════════
SEMANTIC_SEARCH_ENABLED=true
SEMANTIC_SEARCH_TOP_K=20


# ══════════════════════════════════════════════════════════════════════════════
#  Pipeline settings (same for all backends)
# ══════════════════════════════════════════════════════════════════════════════
SEARCH_PROVIDER=duckduckgo
SEARCH_MAX_RESULTS_PER_QUERY=5
SEARCH_TIMEOUT_SECONDS=20
SEARCH_CACHE_ENABLED=true

SOURCE_VALIDATION_USE_LLM=false
SOURCE_VALIDATION_MIN_RELIABILITY=50
SOURCE_VALIDATION_MIN_RELEVANCE=50

PAGE_READ_TIMEOUT_SECONDS=25
PAGE_MAX_CHARS=12000
PAGE_CACHE_ENABLED=true
PAGE_ALLOWED_DECISIONS=accept,review

EXTRACTION_MAX_PAGES=10
EXTRACTION_MIN_CONFIDENCE=50
EXTRACTION_TEXT_MAX_CHARS=12000

DATABASE_PATH=data/scholarships.db
KNOWLEDGE_BASE_ENABLED=true

RETRIEVAL_ENABLED=true
RETRIEVAL_MAX_RESULTS=10
RETRIEVAL_MIN_SCORE=40
RETRIEVAL_MODE=keyword

MATCHING_USE_LLM=false
MATCHING_MIN_COMPATIBILITY_SCORE=50
MATCHING_LANGUAGE_STRICTNESS=moderate

RANKING_MIN_FINAL_SCORE=50
RANKING_MAX_RESULTS=10

LOG_LEVEL=INFO
