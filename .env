# ============================================================
# MultiAgentic-Becas — Variables de Entorno
# Copia este archivo como .env y rellena tus valores
# ============================================================

# --- AMD Developer Cloud / vLLM ---
# Endpoint del servidor vLLM corriendo LLaMA en AMD MI300X
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=not-required          # vLLM no requiere key, pero el cliente OpenAI sí
VLLM_MODEL=meta-llama/Llama-3.1-70B-Instruct

# --- Fallback: Ollama (desarrollo local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Modo de ejecución ---
# "amd_cloud" = usa vLLM en AMD Developer Cloud
# "ollama"    = usa Ollama local (para desarrollo sin GPU)
LLM_BACKEND=ollama

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2  # Modelo ligero, corre en CPU

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma

# --- App ---
APP_NAME=MultiAgentic-Becas
LOG_LEVEL=INFO
MAX_SCHOLARSHIPS_PER_SEARCH=10
MAX_SEARCH_RESULTS=5
